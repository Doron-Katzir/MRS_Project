%% Project Configuration Parameters

function cfg = ProjectConfig()
    rootDir = "C:\Users\doronkatzir1\Desktop\Thesis_Lab";

    cfg.paths.rootDir = rootDir;
    cfg.paths.dataDir = fullfile(rootDir, "Data");
    cfg.paths.coordDir = fullfile(rootDir, "LCMFit");

    % ---------------------------------------------------------------------
    % Input selection
    % ---------------------------------------------------------------------
    % Two supported modes:
    %
    %   1. "directory"
    %      Search cfg.input.directory for all relevant Twix .dat files.
    %
    %   2. "singleFile"
    %      Use only cfg.input.singleFile.
    %
    % You can also override this from the splice/load scripts using:
    %
    %   Splice_data_multi_patient_input('inputMode', "directory")
    %   Splice_data_multi_patient_input('inputMode', "singleFile")
    %
    % For the multi-patient pipeline, use "directory".

    cfg.input.mode = "directory";     % "directory" or "singleFile"

    % Option 1: directory mode
    cfg.input.directory = cfg.paths.dataDir;
    cfg.input.filePattern = "*.dat";
    cfg.input.recursive = false;

    % Use this to keep only the spectroscopy files you actually want.
    % Set to strings(0,1) or "" to accept every file matching filePattern.
    cfg.input.filenameMustContain = "";
    cfg.input.filenameMustNotContain = strings(0, 1);

    % Patient folder/file prefix naming when discovering from a directory.
    % Options:
    %   "sequential" -> P01, P02, P03, ...
    %   "filename"   -> use sanitized filename as patient ID
    %   "midfid"     -> use MIDxxxx_FIDyyyy if present, otherwise sequential
    cfg.input.patientIDMode = "sequential";

    % Option 2: single-file mode, should be filled from RunExperiment.
    cfg.input.singleFileName = "";
    cfg.input.singleFile = "";
    cfg.input.singlePatientID = "";

    % Backward compatibility with older scripts.
    cfg.files.twixFile = "";

    % ---------------------------------------------------------------------
    % Multi-patient LCModel output safety
    % ---------------------------------------------------------------------
    % These prevent patient files from overwriting one another.
    cfg.output.usePatientSubfolders = true;
    cfg.output.addPatientPrefixToFilenames = true;
    cfg.output.deleteOldLCModelFiles = true;

    cfg.preprocessing.isICEChop = true;
    cfg.preprocessing.numPts = 4096;

    cfg.subsets.setSizes = [1, 2, 4, 6, 9, 12, 18, 36];

    cfg.metabolites.basis = ["NAA", "NAAG", "Cr", "PCr", "GPC", "PCh", ...
        "Glu", "Gln", "GABA", "GSH", "Tau", "Asc", "Glc", "Ace", ...
        "mI", "sI", "Asp", "Lac"];

    cfg.metabolites.sum = ["GPC+PCh", "NAA+NAAG", "Cr+PCr", "Glu+Gln"];

    cfg.metabolites.analysis = [ ...
        cfg.metabolites.basis, ...
        cfg.metabolites.sum ...
        ];

    cfg.lcmodel.valueColumn = "sig";
    cfg.lcmodel.outputNamePattern = "Division_%d_part_%d.basis";
end
