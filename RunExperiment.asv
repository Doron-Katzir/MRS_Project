%% Plot diff matrix
%% Plot difference between average empirical and De Graaf correlation matrices
% Difference = empirical correlation - LCModel amplitude correlation

T_emp = covOutputs.group.meanCorrTable;
T_lcm = deGraafOutputs.group.meanAmplitudeCorrTable;

labelsEmp = string(T_emp.Properties.RowNames);
labelsLCM = string(T_lcm.Properties.RowNames);

% Use only metabolites that exist in both matrices, preserving empirical order
commonLabels = labelsEmp(ismember(labelsEmp, labelsLCM));

[~, idxEmp] = ismember(commonLabels, labelsEmp);
[~, idxLCM] = ismember(commonLabels, labelsLCM);

M_emp = table2array(T_emp(idxEmp, idxEmp));
M_lcm = table2array(T_lcm(idxLCM, idxLCM));

D = M_emp - M_lcm;

figure;
imagesc(D);
axis image;
colorbar;

% Symmetric scale around zero
lim = max(abs(D(:)), [], 'omitnan');

if isempty(lim) || isnan(lim) || lim == 0
    lim = 1;
end

