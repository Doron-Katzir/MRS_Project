%% Compute threshold for reliability
%% CRLB quality overlay for empirical correlation matrix
% Marks cells involving metabolites for which fewer than 90% of instances
% had CRLB < 100%.

crlbThreshold = 100;
requiredGoodFraction = 0.7;

metabList = string(covOutputs.metabList(:));
nMetabs = numel(metabList);

goodCRLBCount = zeros(nMetabs, 1);
totalInstanceCount = zeros(nMetabs, 1);

patientIDs = string(fieldnames(covOutputs.patientResultsByID));

for pIdx = 1:numel(patientIDs)

    patientID = patientIDs(pIdx);

    coordTable = covOutputs.patientResultsByID.(patientID).coordTable;
    partTable  = covOutputs.patientResultsByID.(patientID).partTable;

    % Find the CRLB / %SD column name robustly
    varNames = string(coordTable.Properties.VariableNames);

    crlbCandidates = ["CRLB", "crlb", "SD", "sd", ...
        "percentSD", "PercentSD", "pctSD", "pctCrLB", ...
        "crlbPercent", "CRLBPercent"];

    crlbCol = "";

    for c = crlbCandidates
        if ismember(c, varNames)
            crlbCol = c;
            break;
        end
    end

    if strlength(crlbCol) == 0
        error("Could not find a CRLB / %%SD column in coordTable. Available columns are:\n%s", ...
            strjoin(varNames, ", "));
    end

    T = coordTable;
    T.filename = string(T.filename);
    T.name = string(T.name);

    % Parse division and part from filename
    nRows = height(T);
    division = nan(nRows, 1);
    part = nan(nRows, 1);

    for r = 1:nRows

        [~, baseName, ext] = fileparts(T.filename(r));
        curFile = string(baseName) + string(ext);

        tok = regexp(curFile, ...
            '.*Division_(\d+)_(?:part_)?(\d+)\.basis\.coord$', ...
            'tokens', 'once');

        if isempty(tok)
            continue;
        end

        division(r) = str2double(tok{1});
        part(r) = str2double(tok{2});
    end

    T.division = division;
    T.part = part;

    % Use the same division and parts that entered the empirical matrix
    divisionUsed = covOutputs.settings.division;
    partsUsed = partTable.part;

    T = T(T.division == divisionUsed, :);

    for m = 1:nMetabs

        metabName = metabList(m);

        crlbVals = nan(numel(partsUsed), 1);

        for partIdx = 1:numel(partsUsed)

            curPart = partsUsed(partIdx);

            idx = T.name == metabName & T.part == curPart;

            if sum(idx) >= 1
                tmp = T.(char(crlbCol))(idx);
                crlbVals(partIdx) = double(tmp(1));
            end
        end

        % Denominator is expected analyzed instances.
        % Missing CRLB values count as not-good.
        totalInstanceCount(m) = totalInstanceCount(m) + numel(crlbVals);
        goodCRLBCount(m) = goodCRLBCount(m) + sum(crlbVals < crlbThreshold, 'omitnan');
    end
end

fractionGoodCRLB = goodCRLBCount ./ totalInstanceCount;

badMetabMask = fractionGoodCRLB < requiredGoodFraction;

crlbQualityTable = table( ...
    metabList, ...
    goodCRLBCount, ...
    totalInstanceCount, ...
    fractionGoodCRLB, ...
    badMetabMask, ...
    'VariableNames', { ...
    'metabolite', ...
    'nCRLBUnder100', ...
    'nInstances', ...
    'fractionCRLBUnder100', ...
    'fails90PercentRule'});

disp(crlbQualityTable);

covOutputs.group.crlbQualityTable = crlbQualityTable;
covOutputs.group.fractionGoodCRLB = fractionGoodCRLB;
covOutputs.group.badMetabMask = badMetabMask;

%% Plot empirical correlation matrix with CRLB quality warning overlay

Tcorr = covOutputs.group.meanCorrTable;

M = table2array(Tcorr);
labels = string(Tcorr.Properties.RowNames);

% Match quality vector to matrix label order
[tf, labelIdx] = ismember(labels, metabList);

if any(~tf)
    error("Some matrix labels were not found in metabList.");
end

badForPlot = badMetabMask(labelIdx);

% A cell is flagged if either metabolite in the pair fails the 90% CRLB rule
badCellMask = badForPlot(:) | badForPlot(:).';

figure;
imagesc(M);
axis image;
colorbar;

caxis([-1 1]);
colormap(gray);

title("Empirical correlation matrix with CRLB quality warning", ...
    'Interpreter', 'none');

xticks(1:numel(labels));
xticklabels(labels);
xtickangle(45);

yticks(1:numel(labels));
yticklabels(labels);

set(gca, 'TickLabelInterpreter', 'none');
set(gca, 'FontSize', 15);

hold on;

[rowBad, colBad] = find(badCellMask);

% White outline plus black X, visible on both dark and light gray cells
plot(colBad, rowBad, 'wo', ...
    'MarkerSize', 8, ...
    'LineWidth', 1.2, ...
    'HandleVisibility', 'off');

plot(colBad, rowBad, 'kx', ...
    'MarkerSize', 7, ...
    'LineWidth', 1.4, ...
    'DisplayName', '<90% CRLB<100');

hold off;

legend('Location', 'eastoutside');


%% Create ranked list of absolute matrix differences
% Difference = abs LCModel amplitude correlation - abs empirical correlation

T_emp = covOutputs.group.meanAbsCorrTable;
T_lcm = deGraafOutputs.group.meanAbsAmplitudeCorrTable;

labelsEmp = string(T_emp.Properties.RowNames);
labelsLCM = string(T_lcm.Properties.RowNames);

% Use only metabolites that exist in both matrices
commonLabels = labelsEmp(ismember(labelsEmp, labelsLCM));

[~, idxEmp] = ismember(commonLabels, labelsEmp);
[~, idxLCM] = ismember(commonLabels, labelsLCM);

M_emp = table2array(T_emp(idxEmp, idxEmp));
M_lcm = table2array(T_lcm(idxLCM, idxLCM));

diffAbs = M_lcm - M_emp;
absDiff = abs(diffAbs);

% Use only upper triangle to avoid duplicate pairs and remove diagonal
upperMask = triu(true(numel(commonLabels)), 1);

[rowIdx, colIdx] = find(upperMask);

metabA = commonLabels(rowIdx);
metabB = commonLabels(colIdx);

empAbsVals = M_emp(upperMask);
lcmAbsVals = M_lcm(upperMask);
diffVals = diffAbs(upperMask);
absDiffVals = absDiff(upperMask);

rankedDiffTable = table( ...
    metabA, ...
    metabB, ...
    empAbsVals, ...
    lcmAbsVals, ...
    diffVals, ...
    absDiffVals, ...
    'VariableNames', { ...
    'metaboliteA', ...
    'metaboliteB', ...
    'absEmpiricalCorr', ...
    'absLCModelCorr', ...
    'diff_LCM_minus_empirical', ...
    'absDifference'});

% Remove rows where one of the values is NaN
rankedDiffTable = rankedDiffTable(~isnan(rankedDiffTable.diff_LCM_minus_empirical), :);

% Biggest signed difference at top, lowest at bottom
rankedDiffTable = sortrows(rankedDiffTable, ...
    'diff_LCM_minus_empirical', ...
    'descend');

rankedDiffTable

%% Export reliability table and ranked difference table

%% Create ranked difference table if it does not already exist

T_emp = covOutputs.group.meanAbsCorrTable;
T_lcm = deGraafOutputs.group.meanAbsAmplitudeCorrTable;

labelsEmp = string(T_emp.Properties.RowNames);
labelsLCM = string(T_lcm.Properties.RowNames);

commonLabels = labelsEmp(ismember(labelsEmp, labelsLCM));

[~, idxEmp] = ismember(commonLabels, labelsEmp);
[~, idxLCM] = ismember(commonLabels, labelsLCM);

M_emp = table2array(T_emp(idxEmp, idxEmp));
M_lcm = table2array(T_lcm(idxLCM, idxLCM));

diffAbs = M_lcm - M_emp;
absDiff = abs(diffAbs);

upperMask = triu(true(numel(commonLabels)), 1);

[rowIdx, colIdx] = find(upperMask);

metabA = commonLabels(rowIdx);
metabB = commonLabels(colIdx);

empAbsVals = M_emp(upperMask);
lcmAbsVals = M_lcm(upperMask);
diffVals = diffAbs(upperMask);
absDiffVals = absDiff(upperMask);

rankedDiffTable = table( ...
    metabA, ...
    metabB, ...
    empAbsVals, ...
    lcmAbsVals, ...
    diffVals, ...
    absDiffVals, ...
    'VariableNames', { ...
    'metaboliteA', ...
    'metaboliteB', ...
    'absEmpiricalCorr', ...
    'absLCModelCorr', ...
    'diff_LCM_minus_empirical', ...
    'absDifference'});

rankedDiffTable = rankedDiffTable(~isnan(rankedDiffTable.diff_LCM_minus_empirical), :);

rankedByMagnitudeTable = sortrows(rankedDiffTable, ...
    'absDifference', ...
    'descend');

outputFile = fullfile(pwd, "Matrix_QC_and_Ranked_Differences.xlsx");

% If the reliability table is stored inside covOutputs:
crlbQualityTable = covOutputs.group.crlbQualityTable;

% If your ranking table is called rankedByMagnitudeTable:
% rankedByMagnitudeTable should already exist from the ranking code

writetable(crlbQualityTable, outputFile, ...
    'Sheet', 'CRLB_reliability');

writetable(rankedByMagnitudeTable, outputFile, ...
    'Sheet', 'Ranked_differences');

fprintf("Saved tables to:\n%s\n", outputFile);

%% Add CRLB pass/fail information to ranked difference table

% Use stored reliability table if available
if isfield(covOutputs.group, "crlbQualityTable")
    crlbQualityTable = covOutputs.group.crlbQualityTable;
end

% Make sure names are strings
crlbQualityTable.metabolite = string(crlbQualityTable.metabolite);
rankedByMagnitudeTable.metaboliteA = string(rankedByMagnitudeTable.metaboliteA);
rankedByMagnitudeTable.metaboliteB = string(rankedByMagnitudeTable.metaboliteB);

% Match each metabolite in the ranking table to the CRLB reliability table
[tfA, idxA] = ismember(rankedByMagnitudeTable.metaboliteA, crlbQualityTable.metabolite);
[tfB, idxB] = ismember(rankedByMagnitudeTable.metaboliteB, crlbQualityTable.metabolite);

if any(~tfA)
    missingA = unique(rankedByMagnitudeTable.metaboliteA(~tfA));
    error("Some metaboliteA names were not found in crlbQualityTable: %s", ...
        strjoin(missingA, ", "));
end

if any(~tfB)
    missingB = unique(rankedByMagnitudeTable.metaboliteB(~tfB));
    error("Some metaboliteB names were not found in crlbQualityTable: %s", ...
        strjoin(missingB, ", "));
end

% Extract per-metabolite CRLB reliability
failA = crlbQualityTable.fails90PercentRule(idxA);
failB = crlbQualityTable.fails90PercentRule(idxB);

fracA = crlbQualityTable.fractionCRLBUnder100(idxA);
fracB = crlbQualityTable.fractionCRLBUnder100(idxB);

% Pair fails if either metabolite fails
pairFailsCRLB = failA | failB;

pairCRLBStatus = strings(height(rankedByMagnitudeTable), 1);
pairCRLBStatus(~pairFailsCRLB) = "PASS";
pairCRLBStatus(pairFailsCRLB) = "FAIL";

% Add columns to the ranking table
rankedByMagnitudeTable.CRLB_pair_status = pairCRLBStatus;
rankedByMagnitudeTable.metaboliteA_fractionCRLBUnder100 = fracA;
rankedByMagnitudeTable.metaboliteB_fractionCRLBUnder100 = fracB;
rankedByMagnitudeTable.metaboliteA_failsCRLB = failA;
rankedByMagnitudeTable.metaboliteB_failsCRLB = failB;

outputFile = fullfile(pwd, "Matrix_QC_and_Ranked_Differences.xlsx");

writetable(crlbQualityTable, outputFile, ...
    'Sheet', 'CRLB_reliability');

writetable(rankedByMagnitudeTable, outputFile, ...
    'Sheet', 'Ranked_differences_with_CRLB');

fprintf("Saved tables to:\n%s\n", outputFile);


%% Create ranked empirical-vs-DeGraaf table with CRLB pass/fail and export to CSV

% =========================
% Settings
% =========================

outputFile = fullfile(pwd, "Ranked_Empirical_vs_DeGraaf_with_CRLB.csv");

% =========================
% Load absolute correlation matrices
% =========================

T_emp = covOutputs.group.meanAbsCorrTable;
T_lcm = deGraafOutputs.group.meanAbsAmplitudeCorrTable;

labelsEmp = string(T_emp.Properties.RowNames);
labelsLCM = string(T_lcm.Properties.RowNames);

% Use only metabolites that exist in both matrices
commonLabels = labelsEmp(ismember(labelsEmp, labelsLCM));

[~, idxEmp] = ismember(commonLabels, labelsEmp);
[~, idxLCM] = ismember(commonLabels, labelsLCM);

M_emp = table2array(T_emp(idxEmp, idxEmp));
M_lcm = table2array(T_lcm(idxLCM, idxLCM));

% =========================
% Difference calculations
% =========================

% Signed difference:
% positive = LCModel / DeGraaf larger
% negative = empirical larger
diff_LCM_minus_empirical = M_lcm - M_emp;

% Absolute disagreement regardless of direction
absDifference = abs(diff_LCM_minus_empirical);

% =========================
% Convert matrix to pairwise table
% Use upper triangle only to avoid duplicate pairs and diagonal
% =========================

upperMask = triu(true(numel(commonLabels)), 1);

[rowIdx, colIdx] = find(upperMask);

metaboliteA = commonLabels(rowIdx);
metaboliteB = commonLabels(colIdx);

absEmpiricalCorr = M_emp(upperMask);
absLCModelCorr = M_lcm(upperMask);

diffVals = diff_LCM_minus_empirical(upperMask);
absDiffVals = absDifference(upperMask);

rankedTable = table( ...
    metaboliteA, ...
    metaboliteB, ...
    absEmpiricalCorr, ...
    absLCModelCorr, ...
    diffVals, ...
    absDiffVals, ...
    'VariableNames', { ...
    'metaboliteA', ...
    'metaboliteB', ...
    'absEmpiricalCorr', ...
    'absLCModelCorr', ...
    'diff_LCM_minus_empirical', ...
    'absDifference'});

% Remove rows with missing values
rankedTable = rankedTable(~isnan(rankedTable.diff_LCM_minus_empirical), :);

% =========================
% Add relative empirical / DeGraaf values
% =========================

emp = rankedTable.absEmpiricalCorr;
lcm = rankedTable.absLCModelCorr;

empirical_over_LCModel = nan(height(rankedTable), 1);
LCModel_over_empirical = nan(height(rankedTable), 1);
relativeDiff_LCM_minus_empirical_percent = nan(height(rankedTable), 1);

validLCM = ~isnan(lcm) & lcm ~= 0;
validEmp = ~isnan(emp) & emp ~= 0;

% Empirical magnitude divided by LCModel magnitude
empirical_over_LCModel(validLCM) = emp(validLCM) ./ lcm(validLCM);

% LCModel magnitude divided by empirical magnitude
LCModel_over_empirical(validEmp) = lcm(validEmp) ./ emp(validEmp);

% Relative signed difference using LCModel as reference
% positive = LCModel larger than empirical
% negative = empirical larger than LCModel
relativeDiff_LCM_minus_empirical_percent(validLCM) = ...
    100 * (lcm(validLCM) - emp(validLCM)) ./ lcm(validLCM);

rankedTable.empirical_over_LCModel = empirical_over_LCModel;
rankedTable.LCModel_over_empirical = LCModel_over_empirical;
rankedTable.relativeDiff_LCM_minus_empirical_percent = relativeDiff_LCM_minus_empirical_percent;

% =========================
% Add CRLB pass/fail information
% =========================

if isfield(covOutputs.group, "crlbQualityTable")
    crlbQualityTable = covOutputs.group.crlbQualityTable;
else
    error("covOutputs.group.crlbQualityTable was not found. Run the CRLB reliability block first.");
end

crlbQualityTable.metabolite = string(crlbQualityTable.metabolite);
rankedTable.metaboliteA = string(rankedTable.metaboliteA);
rankedTable.metaboliteB = string(rankedTable.metaboliteB);

[tfA, idxA] = ismember(rankedTable.metaboliteA, crlbQualityTable.metabolite);
[tfB, idxB] = ismember(rankedTable.metaboliteB, crlbQualityTable.metabolite);

if any(~tfA)
    missingA = unique(rankedTable.metaboliteA(~tfA));
    error("Some metaboliteA names were not found in crlbQualityTable: %s", ...
        strjoin(missingA, ", "));
end

if any(~tfB)
    missingB = unique(rankedTable.metaboliteB(~tfB));
    error("Some metaboliteB names were not found in crlbQualityTable: %s", ...
        strjoin(missingB, ", "));
end

failA = crlbQualityTable.fails90PercentRule(idxA);
failB = crlbQualityTable.fails90PercentRule(idxB);

fracA = crlbQualityTable.fractionCRLBUnder100(idxA);
fracB = crlbQualityTable.fractionCRLBUnder100(idxB);

pairFailsCRLB = failA | failB;

CRLB_pair_status = strings(height(rankedTable), 1);
CRLB_pair_status(~pairFailsCRLB) = "PASS";
CRLB_pair_status(pairFailsCRLB) = "FAIL";

rankedTable.CRLB_pair_status = CRLB_pair_status;
rankedTable.metaboliteA_fractionCRLBUnder100 = fracA;
rankedTable.metaboliteB_fractionCRLBUnder100 = fracB;
rankedTable.metaboliteA_failsCRLB = failA;
rankedTable.metaboliteB_failsCRLB = failB;

% =========================
% Sort table
% Biggest disagreement at top
% =========================

rankedTable = sortrows(rankedTable, "absDifference", "descend");

% Optional: also store in workspace under a clear name
rankedEmpiricalDeGraafCRLBTable = rankedTable;

% =========================
% Export to CSV
% =========================

writetable(rankedEmpiricalDeGraafCRLBTable, outputFile);

fprintf("Saved ranked table to:\n%s\n", outputFile);


%% Scatter plots with CRLB 90%-under-100% pass/fail status
% Plots:
%   1. GABA vs Glu
%   2. All sum metabolites against all sum metabolites
%
% Uses:
%   covOutputs.patientResultsByID.(patientID).partTable
%   covOutputs.group.crlbQualityTable

clearvars patientID safePatientID T

% Choose patient

patientID = "P01"; 
safePatientID = matlab.lang.makeValidName(char(patientID));

T = covOutputs.patientResultsByID.(safePatientID).partTable;

% Get CRLB reliability table

if ~isfield(covOutputs.group, "crlbQualityTable")
    error("covOutputs.group.crlbQualityTable does not exist. Run the CRLB reliability block first.");
end

crlbQualityTable = covOutputs.group.crlbQualityTable;
crlbQualityTable.metabolite = string(crlbQualityTable.metabolite);

% ============================================================
% 1. Scatter plot: GABA vs Glu
% ============================================================

xName = "Glu";
yName = "GABA";

xCol = matlab.lang.makeValidName(char(xName));
yCol = matlab.lang.makeValidName(char(yName));

x = T.(xCol);
y = T.(yCol);

valid = ~isnan(x) & ~isnan(y);
nValid = sum(valid);

if nValid >= 3
    rVal = corr(x(valid), y(valid));
else
    rVal = NaN;
end

% CRLB reliability lookup for x metabolite
idxX = find(crlbQualityTable.metabolite == xName, 1);
idxY = find(crlbQualityTable.metabolite == yName, 1);

if isempty(idxX)
    error("Could not find %s in crlbQualityTable.", xName);
end

if isempty(idxY)
    error("Could not find %s in crlbQualityTable.", yName);
end

requiredGoodFraction = 0.90;

fracX = crlbQualityTable.fractionCRLBUnder100(idxX);
fracY = crlbQualityTable.fractionCRLBUnder100(idxY);

passX = fracX >= requiredGoodFraction;
passY = fracY >= requiredGoodFraction;

pairPassesCRLB = passX & passY;

if pairPassesCRLB
    crlbStatus = "CRLB PASS";
else
    crlbStatus = "CRLB FAIL";
end

figure;
scatter(x(valid), y(valid), 60, 'filled');
grid on;

xlabel(xName, 'Interpreter', 'none');
ylabel(yName, 'Interpreter', 'none');

title(sprintf('%s: %s vs %s | r = %.2f, n = %d | %s\n%s %.0f%% good, %s %.0f%% good', ...
    patientID, ...
    yName, xName, ...
    rVal, nValid, ...
    crlbStatus, ...
    xName, 100 * fracX, ...
    yName, 100 * fracY), ...
    'Interpreter', 'none');

set(gca, 'FontSize', 14);


% ============================================================
% 2. Scatter plots: all sum metabolites against all sum metabolites
% ============================================================

sumMetabs = ["GPC+PCh", "NAA+NAAG", "Cr+PCr", "Glu+Gln"];

nSums = numel(sumMetabs);
nPairs = nchoosek(nSums, 2);

nCols = ceil(sqrt(nPairs));
nRows = ceil(nPairs / nCols);

figure;
tiledlayout(nRows, nCols, ...
    'TileSpacing', 'compact', ...
    'Padding', 'compact');

for a = 1:nSums-1

    for b = a+1:nSums

        xName = sumMetabs(a);
        yName = sumMetabs(b);

        xCol = matlab.lang.makeValidName(char(xName));
        yCol = matlab.lang.makeValidName(char(yName));

        x = T.(xCol);
        y = T.(yCol);

        valid = ~isnan(x) & ~isnan(y);
        nValid = sum(valid);

        if nValid >= 3
            rVal = corr(x(valid), y(valid));
        else
            rVal = NaN;
        end

        % CRLB reliability lookup
        idxX = find(crlbQualityTable.metabolite == xName, 1);
        idxY = find(crlbQualityTable.metabolite == yName, 1);

        if isempty(idxX)
            error("Could not find %s in crlbQualityTable.", xName);
        end

        if isempty(idxY)
            error("Could not find %s in crlbQualityTable.", yName);
        end

        failX = crlbQualityTable.fails90PercentRule(idxX);
        failY = crlbQualityTable.fails90PercentRule(idxY);

        fracX = crlbQualityTable.fractionCRLBUnder100(idxX);
        fracY = crlbQualityTable.fractionCRLBUnder100(idxY);

        pairFailsCRLB = failX | failY;

        if pairFailsCRLB
            crlbStatus = "CRLB FAIL";
        else
            crlbStatus = "CRLB PASS";
        end

        nexttile;

        scatter(x(valid), y(valid), 45, 'filled');
        grid on;

        xlabel(xName, 'Interpreter', 'none');
        ylabel(yName, 'Interpreter', 'none');

        title(sprintf('r = %.2f, n = %d | %s\n%s %.0f%%, %s %.0f%%', ...
            rVal, nValid, ...
            crlbStatus, ...
            xName, 100 * fracX, ...
            yName, 100 * fracY), ...
            'Interpreter', 'none');

        set(gca, 'FontSize', 10);
    end
end

sgtitle("Sum-metabolite scatter plots with CRLB status - " + patientID, ...
    'Interpreter', 'none');



%% Multi-patient pooled scatter: within-patient z-scored values
% Good for visualizing within-patient empirical association across all patients

xName = "Glu";
yName = "GABA";

patientIDs = string(fieldnames(covOutputs.patientResultsByID));

allX = [];
allY = [];
allPatient = strings(0, 1);

perPatientR = nan(numel(patientIDs), 1);
perPatientN = nan(numel(patientIDs), 1);

for pIdx = 1:numel(patientIDs)

    patientID = patientIDs(pIdx);
    T = covOutputs.patientResultsByID.(patientID).partTable;

    xCol = matlab.lang.makeValidName(char(xName));
    yCol = matlab.lang.makeValidName(char(yName));

    x = T.(xCol);
    y = T.(yCol);

    valid = ~isnan(x) & ~isnan(y);
    nValid = sum(valid);

    perPatientN(pIdx) = nValid;

    if nValid < 3
        continue;
    end

    xv = x(valid);
    yv = y(valid);

    % Per-patient correlation on raw values
    perPatientR(pIdx) = corr(xv, yv);

    % Z-score within patient
    zx = (xv - mean(xv, 'omitnan')) ./ std(xv, 0, 'omitnan');
    zy = (yv - mean(yv, 'omitnan')) ./ std(yv, 0, 'omitnan');

    allX = [allX; zx]; %#ok<AGROW>
    allY = [allY; zy]; %#ok<AGROW>
    allPatient = [allPatient; repmat(patientID, numel(zx), 1)]; %#ok<AGROW>
end

% Pooled within-patient z-scored correlation
validPool = ~isnan(allX) & ~isnan(allY);

if sum(validPool) >= 3
    pooledWithinPatientR = corr(allX(validPool), allY(validPool));
else
    pooledWithinPatientR = NaN;
end

meanPatientR = mean(perPatientR, 'omitnan');
medianPatientR = median(perPatientR, 'omitnan');

figure;
gscatter(allX, allY, allPatient);
grid on;

xlabel("Within-patient z-score: " + xName, 'Interpreter', 'none');
ylabel("Within-patient z-score: " + yName, 'Interpreter', 'none');

title(sprintf(['Multi-patient pooled scatter: %s vs %s\n' ...
    'pooled within-patient z r = %.2f | mean patient r = %.2f | median patient r = %.2f'], ...
    yName, xName, pooledWithinPatientR, meanPatientR, medianPatientR), ...
    'Interpreter', 'none');

legend('Location', 'eastoutside');
set(gca, 'FontSize', 13);



%% Scatter plots for all patients with corrected CRLB pass/fail logic
% Plots for each patient:
%   1. GABA vs Glu
%   2. All sum-metabolites against all sum-metabolites
%
% CRLB rule:
%   A pair passes only if BOTH metabolites have fractionCRLBUnder100 >= 0.90

% Settings

requiredGoodFraction = 0.90;

sumMetabs = ["GPC+PCh", "NAA+NAAG", "Cr+PCr", "Glu+Gln"];

patientIDs = string(fieldnames(covOutputs.patientResultsByID));

% Load CRLB reliability table

if ~isfield(covOutputs.group, "crlbQualityTable")
    error("covOutputs.group.crlbQualityTable does not exist. Run the CRLB reliability block first.");
end

crlbQualityTable = covOutputs.group.crlbQualityTable;
crlbQualityTable.metabolite = string(crlbQualityTable.metabolite);

% Loop over patients
start=10;
count=10;

for pIdx = 1+start:count+start

    patientID = patientIDs(pIdx);

    fprintf("Plotting patient %s...\n", patientID);

    T = covOutputs.patientResultsByID.(char(patientID)).partTable;

    % ========================================================
    % 1. GABA vs Glu
    % ========================================================

    xName = "Glu";
    yName = "GABA";

    xCol = matlab.lang.makeValidName(char(xName));
    yCol = matlab.lang.makeValidName(char(yName));

    if ~ismember(xCol, string(T.Properties.VariableNames))
        warning("Skipping %s vs %s for patient %s because %s was not found.", ...
            yName, xName, patientID, xCol);
    elseif ~ismember(yCol, string(T.Properties.VariableNames))
        warning("Skipping %s vs %s for patient %s because %s was not found.", ...
            yName, xName, patientID, yCol);
    else

        x = T.(xCol);
        y = T.(yCol);

        valid = ~isnan(x) & ~isnan(y);
        nValid = sum(valid);

        if nValid >= 3
            rVal = corr(x(valid), y(valid));
        else
            rVal = NaN;
        end

        idxX = find(crlbQualityTable.metabolite == xName, 1);
        idxY = find(crlbQualityTable.metabolite == yName, 1);

        if isempty(idxX)
            error("Could not find %s in crlbQualityTable.", xName);
        end

        if isempty(idxY)
            error("Could not find %s in crlbQualityTable.", yName);
        end

        fracX = crlbQualityTable.fractionCRLBUnder100(idxX);
        fracY = crlbQualityTable.fractionCRLBUnder100(idxY);

        passX = fracX >= requiredGoodFraction;
        passY = fracY >= requiredGoodFraction;

        pairPassesCRLB = passX & passY;

        if pairPassesCRLB
            crlbStatus = "CRLB PASS";
        else
            crlbStatus = "CRLB FAIL";
        end

        figure;
        scatter(x(valid), y(valid), 60, 'filled');
        grid on;

        xlabel(xName, 'Interpreter', 'none');
        ylabel(yName, 'Interpreter', 'none');

        title(sprintf('%s: %s vs %s | r = %.2f, n = %d | %s\n%s %.0f%% CRLB<100, %s %.0f%% CRLB<100', ...
            patientID, ...
            yName, xName, ...
            rVal, nValid, ...
            crlbStatus, ...
            xName, 100 * fracX, ...
            yName, 100 * fracY), ...
            'Interpreter', 'none');

        set(gca, 'FontSize', 14);
    end


    % ========================================================
    % 2. All sum-metabolites against all sum-metabolites
    % ========================================================

    nSums = numel(sumMetabs);
    nPairs = nchoosek(nSums, 2);

    nCols = ceil(sqrt(nPairs));
    nRows = ceil(nPairs / nCols);

    figure;
    tiledlayout(nRows, nCols, ...
        'TileSpacing', 'compact', ...
        'Padding', 'compact');

    for a = 1:nSums-1

        for b = a+1:nSums

            xName = sumMetabs(a);
            yName = sumMetabs(b);

            xCol = matlab.lang.makeValidName(char(xName));
            yCol = matlab.lang.makeValidName(char(yName));

            nexttile;

            if ~ismember(xCol, string(T.Properties.VariableNames)) || ...
               ~ismember(yCol, string(T.Properties.VariableNames))

                text(0.5, 0.5, ...
                    sprintf('Missing data:\n%s vs %s', yName, xName), ...
                    'HorizontalAlignment', 'center', ...
                    'Interpreter', 'none');

                axis off;
                continue;
            end

            x = T.(xCol);
            y = T.(yCol);

            valid = ~isnan(x) & ~isnan(y);
            nValid = sum(valid);

            if nValid >= 3
                rVal = corr(x(valid), y(valid));
            else
                rVal = NaN;
            end

            idxX = find(crlbQualityTable.metabolite == xName, 1);
            idxY = find(crlbQualityTable.metabolite == yName, 1);

            if isempty(idxX)
                error("Could not find %s in crlbQualityTable.", xName);
            end

            if isempty(idxY)
                error("Could not find %s in crlbQualityTable.", yName);
            end

            fracX = crlbQualityTable.fractionCRLBUnder100(idxX);
            fracY = crlbQualityTable.fractionCRLBUnder100(idxY);

            passX = fracX >= requiredGoodFraction;
            passY = fracY >= requiredGoodFraction;

            pairPassesCRLB = passX & passY;

            if pairPassesCRLB
                crlbStatus = "CRLB PASS";
            else
                crlbStatus = "CRLB FAIL";
            end

            scatter(x(valid), y(valid), 45, 'filled');
            grid on;

            xlabel(xName, 'Interpreter', 'none');
            ylabel(yName, 'Interpreter', 'none');

            title(sprintf('r = %.2f, n = %d'));

            set(gca, 'FontSize', 10);
        end
    end

    sgtitle("Sum-metabolite scatter plots with CRLB status - " + patientID, ...
        'Interpreter', 'none');
end