diffTable = array2table(D, ...
    'VariableNames', matlab.lang.makeValidName(cellstr(commonLabels)), ...
    'RowNames', cellstr(commonLabels));

%% Plot raw signals
%% Plot normalized GPC/PCh/GPC+PCh curves for all patients

patientIDs = string(fieldnames(covOutputs.patientResultsByID));
% nPatients = numel(patientIDs);
nPatients = 9;
startPatient = 1;

nCols = ceil(sqrt(nPatients));
nRows = ceil(nPatients / nCols);

figure;
tiledlayout(nRows, nCols, 'TileSpacing', 'compact', 'Padding', 'compact');

for pIdx = 1:nPatients + startPatient - 1

    patientID = patientIDs(pIdx);

    T = covOutputs.patientResultsByID.(patientID).partTable;

    parts = T.part;

    gpc     = T.GPC;
    pch     = T.PCh;
    gpcPch  = T.GPC_PCh;

    zgpc    = (gpc    - mean(gpc,    'omitnan')) ./ std(gpc,    0, 'omitnan');
    zpch    = (pch    - mean(pch,    'omitnan')) ./ std(pch,    0, 'omitnan');
    zgpcPch = (gpcPch - mean(gpcPch, 'omitnan')) ./ std(gpcPch, 0, 'omitnan');

    % Correlations between the raw concentration vectors
    r_gpc_sum = corr(gpc, gpcPch, 'Rows', 'complete');
    r_pch_sum = corr(pch, gpcPch, 'Rows', 'complete');
    r_gpc_pch = corr(gpc, pch,    'Rows', 'complete');

    nexttile;
    plot(parts, zgpc, '-o', 'DisplayName', 'GPC');
    hold on;
    plot(parts, zpch, '-o', 'DisplayName', 'PCh');
    plot(parts, zgpcPch, '-o', 'DisplayName', 'GPC+PCh');
    yline(0, '--');
    hold off;

    title(sprintf('%s\nr(Sum,GPC)=%.2f  r(Sum,PCh)=%.2f  r(GPC,PCh)=%.2f', ...
    patientID, r_gpc_sum, r_pch_sum, r_gpc_pch), ...
    'Interpreter', 'none');
    xlabel('Part');
    ylabel('Z');
    grid on;

    set(gca, 'FontSize', 7);
end

lgd = legend('GPC', 'PCh', 'GPC+PCh');
